# 复制本文件为 .env 并填入你的 key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# --- 向量记忆后端 ---
# json（默认，零依赖，内存 + JSON 落盘）/ chroma（chromadb 持久化 + HNSW）
# 选 chroma 需要装 requirements-chroma.txt；装不上会自动降级回 json 并打一行警告。
#
# 这里刻意保持注释状态：docker compose 那侧用的是
# `${CORTEX_MEMORY_STORE:-chroma}`，不设时默认走 chroma。
# 如果把下面这行放开成 json，compose 会把它当显式配置传给容器，
# 服务器就会用 JSON 后端、把迁移过去的 chroma 记忆晾在一边——很难发现的坑。
# CORTEX_MEMORY_STORE=chroma

# --- 部署相关（Docker）---
# 对外端口（docker compose 用；Caddy 监听容器内 8000，映射到这个宿主机端口）
CORTEX_PORT=8000

# HTTP Basic 鉴权，由 compose 注入 caddy 容器（见 deploy/Caddyfile）。
# 哈希生成（不要填明文）：
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '你的密码'
# 输出的整串含 $ 符号，用带引号的 heredoc 写进 .env，否则 shell 会把 $2a 当变量展开。
CORTEX_AUTH_USER=cortex
# CORTEX_AUTH_HASH=$2a$14$在这里粘贴上一步的输出

# 仅当不用 Docker、直接 `python backend/main.py` 时生效。
# 默认 127.0.0.1 是刻意的安全默认；要对外必须显式改成 0.0.0.0。
# CORTEX_HOST=0.0.0.0
