# 复制本文件为 .env 并填入你的 key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# --- 向量记忆后端 ---
# json（默认，零依赖，内存 + JSON 落盘）/ chroma（chromadb 持久化 + HNSW）
# 选 chroma 需要装 requirements-chroma.txt；装不上会自动降级回 json 并打一行警告。
#
# 这里刻意保持注释状态：docker compose 那侧用的是
# `${CORTEX_MEMORY_STORE:-chroma}`，不设时默认走 chroma。
# 如果把下面这行放开成 json，compose 会把它当显式配置传给容器，
# 服务器就会用 JSON 后端、把迁移过去的 chroma 记忆晾在一边——很难发现的坑。
# CORTEX_MEMORY_STORE=chroma

# --- 人工审批闸门（human-in-the-loop）---
# write_file / run_command 执行前先挂起，等人点「批准」才落地。
# Web 演示里**默认开启**：关着的话审批卡片永远不会出现，这个特性等于不存在。
# 想恢复「全部自动执行」的老行为，显式写 0：
# CORTEX_APPROVAL=0

# 白名单：这些工具自动放行、不弹审批（逗号分隔）。
# 用于「我就想让这条命令自己跑」的受控场景，而不是把整个闸门关掉。
# CORTEX_APPROVAL_SKIP=run_command

# 单次运行的墙上时间上限（秒）。不设 = 不限时。
# 挂起等审批的时间不计入这个预算（人思考的时间不该算成 agent 在跑）。
# CORTEX_RUN_TIMEOUT=120

# 单次运行的 token 上限（输入+输出）。不设 = 不限。
#
# 前两个维度挡不住「上下文很大、来回好几轮」的运行：步数没超、也没超时，
# 钱却已经花出去了。token 才是真正的成本维度，所以单独给一条。
# 注意：需要 LLM 接口返回 usage 才能计数（llm.py 已开 stream_usage）；
# 拿不到用量时计数器保持不动，这个上限就不会触发——不猜也不补 0。
# CORTEX_MAX_TOKENS=50000

# --- 成本核算（可选）---
# 单价按「元 / 百万 token」填，与各家 API 的报价口径一致。
# **两个都配**才会算出金额；缺任一个就只报 token 不算钱（/api/metrics 里
# cost.amount 为 null、priced 为 false）。刻意不内置默认单价：价格会变，
# 硬编码一个过期数字比不显示更糟——它会让人以为自己看到了真实成本。
# CORTEX_PRICE_IN=2.0
# CORTEX_PRICE_OUT=8.0

# --- 部署相关（Docker）---
# 对外端口（docker compose 用；Caddy 监听容器内 8000，映射到这个宿主机端口）
CORTEX_PORT=8000

# HTTP Basic 鉴权，由 compose 注入 caddy 容器（见 deploy/Caddyfile）。
# 哈希生成（不要填明文）：
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '你的密码'
# 输出的整串含 $ 符号，用带引号的 heredoc 写进 .env，否则 shell 会把 $2a 当变量展开。
CORTEX_AUTH_USER=cortex
# CORTEX_AUTH_HASH=$2a$14$在这里粘贴上一步的输出

# 仅当不用 Docker、直接 `python backend/main.py` 时生效。
# 默认 127.0.0.1 是刻意的安全默认；要对外必须显式改成 0.0.0.0。
# CORTEX_HOST=0.0.0.0
